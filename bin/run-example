#!/usr/bin/env sh
# Copyright 2026 Mark Kimberly Howe. Licensed under the MIT License.

set -eu

if [ "$#" -lt 1 ]; then
    echo "Usage: $0 example-name [-- program arguments ...]" >&2
    exit 2
fi

repository_dir=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
example_name=$1
shift

case "$example_name" in
    ""|.*|*/*)
        echo "Example name must be one directory directly under examples." >&2
        exit 2
        ;;
esac

entry_file="$repository_dir/examples/$example_name/Main.st"
if [ ! -f "$entry_file" ]; then
    echo "Unknown example: $example_name" >&2
    echo "Run ./bin/list-examples to see the available examples." >&2
    exit 2
fi

if [ "${1:-}" = "--" ]; then
    shift
fi

if [ -n "${STREUTH_JAR:-}" ]; then
    runtime_jar=$STREUTH_JAR
elif [ -f "$repository_dir/../STreuth/out/artifacts/STreuth_jar/STreuth.jar" ]; then
    runtime_jar="$repository_dir/../STreuth/out/artifacts/STreuth_jar/STreuth.jar"
elif [ -f "$repository_dir/../STreuthBrowser/build/install/STreuthBrowser/lib/STreuth.jar" ]; then
    runtime_jar="$repository_dir/../STreuthBrowser/build/install/STreuthBrowser/lib/STreuth.jar"
else
    echo "STreuth.jar was not found." >&2
    echo "Clone STreuth beside this repository or set STREUTH_JAR." >&2
    exit 1
fi

exec java -cp "$runtime_jar" cli.STreuthCli run "$entry_file" -- "$@"
